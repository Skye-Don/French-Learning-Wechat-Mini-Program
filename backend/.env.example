# ============================================================
# 环境变量样例 —— 复制为 .env 后填写真实值（.env 已被 .gitignore 排除，禁止入库）
# ============================================================

# ---------- 数据库（PostgreSQL 16）----------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=french_miniprogram
DB_USER=french_admin
# 密码请用随机字符串：python -c "import secrets;print(secrets.token_urlsafe(24))"
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- Redis 7 ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
# 必须替换为 64 位随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_AT_LEAST_32_BYTES
JWT_EXPIRE_DAYS=7
JWT_ADMIN_EXPIRE_HOURS=2

# ---------- 微信小程序（微信公众平台 → 开发管理 → 开发设置）----------
# 红线：AppSecret 只存此处，绝不进代码库 / 前端
WX_APPID=your-appid
WX_SECRET=your-app-secret

# ---------- 应用 ----------
# development | production（production 会关闭 /docs 与 /openapi.json）
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ---------- 服务器 ----------
UPLOAD_DIR=/app/uploads

# ---------- CORS 白名单（逗号分隔；生产环境填管理后台域名）----------
CORS_ORIGINS=http://localhost:5173
