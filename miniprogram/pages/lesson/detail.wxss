/* 话题详情页（简化版）：大标题 hero + 两个"开始背"按钮 */
.page { padding: 24rpx; }
.skel {
  height: 150rpx; margin-bottom: 24rpx; border-radius: 24rpx;
  background: linear-gradient(90deg, #efeae4 25%, #f6f2ee 37%, #efeae4 63%);
  background-size: 400% 100%; animation: sk 1.4s ease infinite;
}
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

.hero {
  background: #fff; border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 48rpx 40rpx; margin-bottom: 44rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; line-height: 1.4; }
.hero-desc { font-size: 27rpx; color: #636E72; margin-top: 20rpx; line-height: 1.7; }
.hero-count { font-size: 25rpx; color: #5B7FA5; margin-top: 28rpx; font-weight: 600; }

.start-tip { font-size: 26rpx; color: #636E72; text-align: center; margin-bottom: 24rpx; }
.start-btns { display: flex; flex-direction: column; }
.start-btn { width: 100%; padding: 30rpx 0; font-size: 32rpx; }
.start-btn + .start-btn { margin-top: 24rpx; }
/* 次按钮：浅色描边风格，与主按钮区分层级 */
.start-btn-alt {
  background: #fff; color: #5B7FA5;
  border: 2rpx solid #5B7FA5; box-sizing: border-box;
}
