.page { padding: 24rpx; }
.skel {
  height: 150rpx; margin-bottom: 24rpx; border-radius: 24rpx;
  background: linear-gradient(90deg, #efeae4 25%, #f6f2ee 37%, #efeae4 63%);
  background-size: 400% 100%; animation: sk 1.4s ease infinite;
}
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

.lesson-title { font-size: 32rpx; font-weight: 600; }
.lesson-desc { font-size: 25rpx; color: var(--fr-text2); margin-top: 16rpx; line-height: 1.7; }
.lesson-count { font-size: 24rpx; margin-top: 24rpx; }

.preview-title { font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.preview-item {
  padding: 18rpx 0; border-bottom: 1rpx solid var(--fr-line); font-size: 27rpx;
  display: flex; gap: 16rpx; align-items: baseline;
}
.preview-item:last-of-type { border-bottom: 0; }
.p-fr { color: var(--fr-blue-dark); font-weight: 600; flex: 0 0 auto; }
.p-zh { color: var(--fr-text2); font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.more { font-size: 24rpx; padding-top: 20rpx; }
