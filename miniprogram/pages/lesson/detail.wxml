<view class="page">
  <block wx:if="{{loading}}">
    <view class="skel" wx:for="{{[1,2]}}" wx:key="*this"></view>
  </block>

  <block wx:else>
    <!-- 话题信息（简洁版：大标题 + 描述 + 数量） -->
    <view class="hero">
      <view class="hero-title">{{lesson.title}}</view>
      <view class="hero-desc">{{lesson.description}}</view>
      <view class="hero-count">共 {{total}} 张卡片</view>
    </view>

    <!-- 选择本次背卡数量 -->
    <view class="start-tip">选择本次要背的数量</view>
    <view class="start-btns">
      <button wx:if="{{btn5}}" class="fr-btn start-btn" bindtap="onStartStudy" data-count="5">{{btn5}}</button>
      <button wx:if="{{btn10}}" class="fr-btn start-btn start-btn-alt" bindtap="onStartStudy" data-count="{{count10}}">{{btn10}}</button>
    </view>
  </block>
</view>
