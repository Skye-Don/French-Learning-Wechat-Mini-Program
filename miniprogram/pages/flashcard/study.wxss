/* 闪卡学习页：全部使用兼容性写法（无 3D transform / inset / gap / var()），
   老安卓 WebView 也能正确渲染 —— 修复"卡片错位、内容被裁"问题 */
.study-wrap {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
.skel {
  height: 560rpx; border-radius: 32rpx;
  background: linear-gradient(90deg, #efeae4 25%, #f6f2ee 37%, #efeae4 63%);
  background-size: 400% 100%; animation: sk 1.4s ease infinite;
}
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

.study-progress { display: flex; align-items: center; margin-bottom: 28rpx; }
.progress-bar { flex: 1; height: 12rpx; background: #E8E5E1; border-radius: 6rpx; overflow: hidden; }
.progress-in { height: 100%; background: #5B7FA5; border-radius: 6rpx; transition: width 0.3s; }
.progress-txt { font-size: 24rpx; color: #636E72; margin-left: 20rpx; }

/* 卡片容器：两态切换（点击翻面，淡入过渡） */
.study-card {
  flex: 1; min-height: 700rpx; margin-bottom: 32rpx;
  background: #fff; border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  overflow-y: auto; box-sizing: border-box;
}
.card-face {
  min-height: 700rpx; box-sizing: border-box;
  padding: 48rpx 40rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; position: relative;
  animation: fadeIn 0.25s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.card-back { background: #FCFAF8; }

.fc-front {
  font-size: 60rpx; font-weight: 700; color: #5B7FA5;
  letter-spacing: 2rpx; line-height: 1.3;
}
.fc-hint { font-size: 24rpx; color: #636E72; margin-top: 32rpx; }
.fc-tags { margin-top: 24rpx; }
.fc-tag-item { font-size: 23rpx; color: #636E72; margin: 0 8rpx; }
.fc-sensitive {
  position: absolute; top: 28rpx; right: 28rpx;
  font-size: 22rpx; color: #D4837A;
  background: #FBEFED; padding: 6rpx 16rpx; border-radius: 16rpx;
}
.fc-back-main { font-size: 38rpx; font-weight: 600; margin-bottom: 8rpx; }
.fc-back-sub { font-size: 28rpx; color: #636E72; line-height: 1.7; }
.fc-example {
  background: #F8F6F3; border-radius: 20rpx;
  padding: 24rpx 28rpx; margin-top: 32rpx; width: 100%; text-align: left;
  box-sizing: border-box;
}
.fc-ex-fr { font-size: 29rpx; line-height: 1.6; }
.fc-ex-zh { font-size: 25rpx; color: #636E72; margin-top: 12rpx; line-height: 1.5; }
.fc-tip {
  border-left: 6rpx solid #E8B86D;
  padding: 16rpx 24rpx; margin-top: 28rpx; width: 100%;
  font-size: 25rpx; color: #636E72; line-height: 1.7;
  background: #FDF8EE; border-radius: 0 16rpx 16rpx 0; text-align: left;
  box-sizing: border-box;
}

.study-actions { display: flex; }
.study-actions .fr-btn { flex: 1; padding: 28rpx 0; font-size: 30rpx; }
.study-actions .fr-btn + .fr-btn { margin-left: 24rpx; }
.btn-wrong { background: #D4837A; }
.btn-right { background: #7CB69D; }
