.study-wrap {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
.skel {
  height: 560rpx; border-radius: 32rpx;
  background: linear-gradient(90deg, #efeae4 25%, #f6f2ee 37%, #efeae4 63%);
  background-size: 400% 100%; animation: sk 1.4s ease infinite;
}
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

.study-progress { display: flex; align-items: center; gap: 20rpx; margin-bottom: 28rpx; }
.progress-bar { flex: 1; height: 12rpx; background: var(--fr-line); border-radius: 6rpx; overflow: hidden; }
.progress-in { height: 100%; background: var(--fr-blue); border-radius: 6rpx; transition: width 0.3s; }
.progress-txt { font-size: 24rpx; color: var(--fr-text2); }

/* 3D 翻转 */
.flip-card { flex: 1; perspective: 2400rpx; min-height: 700rpx; margin-bottom: 32rpx; }
.flip-inner {
  position: relative; width: 100%; height: 100%;
  transition: transform 0.55s cubic-bezier(0.4, 0.2, 0.2, 1);
  transform-style: preserve-3d;
}
.flip-card.flipped .flip-inner { transform: rotateY(180deg); }
.flip-face {
  position: absolute; inset: 0;
  backface-visibility: hidden; -webkit-backface-visibility: hidden;
  background: #fff; border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 48rpx 40rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; overflow-y: auto;
}
.flip-back { transform: rotateY(180deg); background: #fcfaf8; }

.fc-front {
  font-size: 60rpx; font-weight: 700; color: var(--fr-blue);
  letter-spacing: 2rpx; line-height: 1.3;
}
.fc-hint { font-size: 24rpx; color: var(--fr-text2); margin-top: 32rpx; }
.fc-tags { margin-top: 24rpx; }
.fc-tag-item { font-size: 23rpx; color: var(--fr-text2); margin: 0 8rpx; }
.fc-sensitive {
  position: absolute; top: 28rpx; right: 28rpx;
  font-size: 22rpx; color: var(--fr-red);
  background: var(--fr-red-light); padding: 6rpx 16rpx; border-radius: 16rpx;
}
.fc-back-main { font-size: 38rpx; font-weight: 600; margin-bottom: 8rpx; }
.fc-back-sub { font-size: 28rpx; color: var(--fr-text2); line-height: 1.7; }
.fc-example {
  background: var(--fr-bg); border-radius: 20rpx;
  padding: 24rpx 28rpx; margin-top: 32rpx; width: 100%; text-align: left;
}
.fc-ex-fr { font-size: 29rpx; line-height: 1.6; }
.fc-ex-zh { font-size: 25rpx; color: var(--fr-text2); margin-top: 12rpx; line-height: 1.5; }
.fc-tip {
  border-left: 6rpx solid var(--fr-yellow);
  padding: 16rpx 24rpx; margin-top: 28rpx; width: 100%;
  font-size: 25rpx; color: var(--fr-text2); line-height: 1.7;
  background: #fdf8ee; border-radius: 0 16rpx 16rpx 0; text-align: left;
  box-sizing: border-box;
}

.study-actions { display: flex; gap: 24rpx; }
.study-actions .fr-btn { flex: 1; padding: 28rpx 0; font-size: 30rpx; }
.btn-wrong { background: var(--fr-red); }
.btn-right { background: var(--fr-green); }
