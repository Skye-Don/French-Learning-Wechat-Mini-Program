.page { padding: 48rpx 40rpx; }

.brand { font-size: 88rpx; text-align: center; margin-top: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; text-align: center; margin-top: 16rpx; }
.subtitle { font-size: 25rpx; color: #9aa0a4; text-align: center; margin: 14rpx 0 36rpx; line-height: 1.6; }

/* 隐私承诺卡 */
.privacy-card {
  background: #edf3f8; border-radius: 24rpx; padding: 30rpx 32rpx;
  margin-bottom: 28rpx;
}
.p-title { font-size: 27rpx; font-weight: 600; color: #5b7fa5; }
.p-text { font-size: 24rpx; color: #5f6b76; line-height: 1.7; margin-top: 12rpx; }

/* 表单卡 */
.form-card {
  background: #fff; border-radius: 24rpx; padding: 12rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 44rpx;
}
.form-row {
  display: flex; align-items: center; padding: 26rpx 0;
  border-bottom: 1rpx solid #f0ebe4;
}
.form-row:last-child { border-bottom: 0; }
.form-label { width: 110rpx; font-size: 28rpx; color: #333; }

/* 头像选择按钮：重置 button 默认样式，圆形浅底 + 人形剪影占位 */
.avatar-btn {
  width: 128rpx; height: 128rpx; padding: 0; margin: 0;
  border-radius: 50%; overflow: hidden; position: relative;
  background: #EDF3F8; border: none;
  display: flex; align-items: center; justify-content: center;
}
.avatar-btn::after { border: 0; }
.avatar-img { width: 128rpx; height: 128rpx; display: block; }

/* 默认占位：品牌色人形剪影（头 + 半身），类似系统默认头像效果 */
.avatar-holder {
  width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center;
  justify-content: flex-end; overflow: hidden;
}
.ph-head {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #5B7FA5; margin-bottom: 10rpx;
}
.ph-body {
  width: 80rpx; height: 42rpx;
  border-radius: 42rpx 42rpx 0 0;
  background: #5B7FA5;
}
/* 右下角相机角标：白描边小圆，提示可点击更换头像 */
.avatar-cam {
  position: absolute; right: 0; bottom: 0;
  width: 42rpx; height: 42rpx; border-radius: 50%;
  background: #5B7FA5;
  border: 4rpx solid #fff; box-sizing: content-box;
  font-size: 20rpx; line-height: 42rpx; text-align: center;
}

.nick-input { flex: 1; font-size: 28rpx; }

.bind-btn { width: 100%; }
.skip {
  text-align: center; font-size: 25rpx; color: #9aa0a4;
  margin-top: 28rpx; padding: 10rpx;
}
.foot-note {
  font-size: 21rpx; color: #c7c2bc; text-align: center;
  margin-top: 48rpx; line-height: 1.6;
}
