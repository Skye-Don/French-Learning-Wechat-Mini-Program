.page { padding: 24rpx; }
.skel {
  height: 160rpx; margin-bottom: 24rpx; border-radius: 24rpx;
  background: linear-gradient(90deg, #efeae4 25%, #f6f2ee 37%, #efeae4 63%);
  background-size: 400% 100%; animation: sk 1.4s ease infinite;
}
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

.between { display: flex; align-items: center; justify-content: space-between; }
.card-title { font-size: 28rpx; font-weight: 600; }
.sub { font-size: 24rpx; margin-top: 8rpx; }
.big-num { font-size: 52rpx; font-weight: 700; color: var(--fr-blue); }
.block-btn { margin-top: 28rpx; }

.lv-code { font-size: 34rpx; font-weight: 700; color: var(--fr-blue); margin-right: 12rpx; }
.lv-name { font-size: 24rpx; margin-right: 12rpx; }
.badge {
  font-size: 21rpx; padding: 4rpx 14rpx; border-radius: 16rpx;
  background: var(--fr-blue-light); color: var(--fr-blue-dark);
}
.arrow { color: #c7c2bc; font-size: 32rpx; }
.level-row:active { opacity: 0.75; }
