.page { padding: 24rpx; }

/* 骨架屏 */
.skel {
  background: linear-gradient(90deg, #efeae4 25%, #f6f2ee 37%, #efeae4 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
  border-radius: 24rpx;
}
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
.hero-skel { height: 300rpx; margin-bottom: 24rpx; }
.level-skel { height: 220rpx; margin-bottom: 24rpx; }

/* 顶部 hero（PRD 5.4） */
.hero {
  background: linear-gradient(135deg, #5b7fa5 0%, #7a9abf 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 8rpx;
}
.hero-top {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 28rpx;
}
.hero-hi { font-size: 40rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }
.avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; border: 4rpx solid rgba(255, 255, 255, 0.5);
}
.goal-text { font-size: 26rpx; line-height: 1.6; }
.goal-num { font-size: 40rpx; font-weight: 700; }
.goal-sub { font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; }
.goal-bar {
  height: 12rpx; background: rgba(255, 255, 255, 0.28);
  border-radius: 6rpx; overflow: hidden; margin: 20rpx 0 18rpx;
}
.goal-bar-in { height: 100%; background: #fff; border-radius: 6rpx; transition: width 0.4s; }
.streak-pill {
  display: inline-flex; align-items: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 40rpx; padding: 8rpx 20rpx; font-size: 24rpx;
}

/* ============================================================
   等级网格（一行两个）
   兼容性写法：不用 gap / calc（部分老 WebView 内核不支持，
   曾导致真机降级成单列）。用 space-between + 48.5% 宽度。
   ============================================================ */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.level-card {
  /* 48.5% + space-between：两列之间自然留出约 3% 间距 */
  width: 48.5%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  background: #fff; border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 32rpx 28rpx; position: relative; overflow: hidden;
}
.level-card.zero { opacity: 0.55; }
.level-card:active { transform: scale(0.98); }
.corner {
  position: absolute; right: -28rpx; top: -28rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: #edf2f7; opacity: 0.6;
}
.level-card:nth-child(2) .corner { background: #fbefed; }
.level-card:nth-child(3) .corner { background: #eaf3ef; }
.level-card:nth-child(4) .corner { background: #fbf3e6; }
.level-code { font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; color: #5b7fa5; position: relative; }
.level-name { font-size: 24rpx; margin-top: 2rpx; position: relative; }
.level-desc {
  font-size: 22rpx; color: #9aa0a4;
  margin-top: 12rpx; line-height: 1.5; height: 66rpx; overflow: hidden; position: relative;
}
.level-count { font-size: 22rpx; color: #5b7fa5; margin-top: 16rpx; position: relative; }

/* 即将上线 */
.coming-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 1rpx dashed #e8e2da; font-size: 26rpx;
}
.coming-item:last-child { border-bottom: 0; }
.coming-item .tag {
  font-size: 22rpx; color: #9aa0a4;
  background: #f8f6f3; padding: 6rpx 16rpx; border-radius: 20rpx;
}

/* 敏感词 opt-in 弹窗 */
.opt-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(45, 52, 54, 0.5);
  display: flex; align-items: center; justify-content: center; z-index: 99; padding: 48rpx;
}
.opt-modal {
  background: #fff; border-radius: 32rpx; padding: 44rpx 40rpx; width: 100%;
  animation: optIn 0.3s ease;
}
@keyframes optIn { from { transform: scale(0.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.opt-title { font-size: 32rpx; font-weight: 600; text-align: center; }
.opt-desc { font-size: 26rpx; color: #9aa0a4; line-height: 1.75; text-align: center; margin: 20rpx 0 30rpx; }
.opt-item {
  border: 3rpx solid #e8e2da; border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx;
}
.opt-item.sel { border-color: #5b7fa5; background: #edf3f8; }
.opt-item-title { font-size: 28rpx; font-weight: 600; }
.opt-item-desc { font-size: 24rpx; color: #9aa0a4; margin-top: 10rpx; line-height: 1.6; }
.opt-close { text-align: center; font-size: 24rpx; color: #9aa0a4; margin-top: 24rpx; padding: 8rpx; }
