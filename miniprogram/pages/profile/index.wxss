.page { padding: 24rpx; }

.profile-head {
  background: linear-gradient(135deg, #5b7fa5, #7a9abf);
  border-radius: 24rpx; padding: 40rpx 32rpx; color: #fff;
  display: flex; align-items: center; gap: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.avatar {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; border: 4rpx solid rgba(255, 255, 255, 0.5);
}
.p-name { font-size: 34rpx; font-weight: 600; }
.p-level { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.stat-row { display: flex; gap: 20rpx; margin: 24rpx 0; }
.stat {
  flex: 1; background: #fff; border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 28rpx 16rpx; text-align: center;
}
.stat-b { display: block; font-size: 44rpx; color: var(--fr-blue); font-weight: 700; }
.stat-s { display: block; font-size: 23rpx; color: var(--fr-text2); margin-top: 6rpx; }

.menu { padding: 0; }
.menu-item {
  display: flex; align-items: center;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--fr-line);
  font-size: 28rpx; width: 100%; text-align: left;
  background: #fff; border-left: 0; border-right: 0; border-top: 0;
  font-family: inherit; color: var(--fr-text); line-height: 1.4;
}
.menu-item::after { border: 0; }
.menu-item:last-child { border-bottom: 0; }
.menu-item:active { background: var(--fr-bg); }
.menu-ico { width: 52rpx; font-size: 32rpx; }
.menu-label { flex: 1; }
.menu-extra { font-size: 24rpx; color: var(--fr-text2); }
.menu-arrow { color: #c7c2bc; font-size: 30rpx; margin-left: 12rpx; }
.share-btn { border-radius: 0; }
.reset-btn { width: 320rpx; font-size: 26rpx; }
