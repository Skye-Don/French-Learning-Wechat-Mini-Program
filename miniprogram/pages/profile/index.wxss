.page { padding: 24rpx; }

.profile-head {
  background: linear-gradient(135deg, #5b7fa5, #7a9abf);
  border-radius: 24rpx; padding: 40rpx 32rpx; color: #fff;
  display: flex; align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
/* 兼容性：不用 gap（老 WebView 内核不支持），用 margin 实现间距 */
.profile-head > view:last-child { margin-left: 28rpx; }
.avatar {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}
.p-name { font-size: 34rpx; font-weight: 600; }
.p-level { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

/* 兼容性：不用 gap，用 margin */
.stat-row { display: flex; margin: 24rpx 0; }
.stat {
  flex: 1; background: #fff; border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 28rpx 16rpx; text-align: center;
}
.stat + .stat { margin-left: 20rpx; }
.stat-b { display: block; font-size: 44rpx; color: #5b7fa5; font-weight: 700; }
.stat-s { display: block; font-size: 23rpx; color: #9aa0a4; margin-top: 6rpx; }

.menu { padding: 0; }
.menu-item {
  display: flex; align-items: center;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid #f0ebe4;
  font-size: 28rpx; width: 100%; text-align: left;
  background: #fff; border-left: 0; border-right: 0; border-top: 0;
  font-family: inherit; color: #333; line-height: 1.4;
}
.menu-item::after { border: 0; }
.menu-item:last-child { border-bottom: 0; }
.menu-item:active { background: #f8f6f3; }
.menu-ico { width: 52rpx; font-size: 32rpx; flex-shrink: 0; }
/* 标签不换行：防止被挤成竖排；flex:1 占据剩余宽度 */
.menu-label { flex: 1; white-space: nowrap; overflow: hidden; }
.menu-extra { font-size: 24rpx; color: #9aa0a4; white-space: nowrap; flex-shrink: 0; }
.menu-arrow { color: #c7c2bc; font-size: 30rpx; margin-left: 12rpx; flex-shrink: 0; }

/* ============================================================
   分享给好友（根治方案）：视觉由 view 负责，button 只做隐形点击层。
   原因：<button open-type="share"> 自带一整套 UA 样式（字号/行高/
   最小宽度/居中），在不同内核上覆盖表现不一致，曾导致文字竖排。
   现在 button 绝对定位铺满整行、完全透明、不参与布局，
   文字排版与普通菜单项 100% 一致，点击仍然触发原生分享。
   ============================================================ */
.share-row { position: relative; }
.share-hit {
  position: absolute; left: 0; top: 0;
  width: 100%; height: 100%;
  margin: 0; padding: 0; border: 0; border-radius: 0;
  background: transparent; opacity: 0; z-index: 2;
  font-size: 0; line-height: 0;
}
.share-hit::after { display: none; border: 0; }

.reset-btn { width: 320rpx; font-size: 26rpx; }

/* 默认头像占位：白色人形剪影（深色头部背景适配） */
.avatar-holder {
  width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center;
  justify-content: flex-end; overflow: hidden; border-radius: 50%;
}
.ph-head { width: 32%; height: 32%; border-radius: 50%; background: rgba(255,255,255,0.9); margin-bottom: 6%; }
.ph-body { width: 62%; height: 30%; border-radius: 50% 50% 0 0; background: rgba(255,255,255,0.9); }
